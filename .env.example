APP_NAME="ASAB SOFT | إدارة العقارات والمقاولات"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA
APP_TIMEZONE=Asia/Riyadh

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=asab_realty
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Mandatory only for first production/installation setup.
PLATFORM_OWNER_NAME="ASAB Platform Owner"
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_PASSWORD=
DEMO_DATA=false
# Docker Compose only: set both to strong unique values (not used in local native mode)
DOCKER_DB_PASSWORD=
DOCKER_MYSQL_ROOT_PASSWORD=

# Optional demo admin (only when DEMO_DATA=true; set strong unique credentials)
DEMO_COMPANY_EMAIL=
DEMO_COMPANY_PASSWORD=
